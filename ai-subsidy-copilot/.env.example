# AI features are optional. In auto mode Gemini is preferred when both keys exist.
# Leave both keys blank to use deterministic demo fallbacks.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REASONING_EFFORT=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=20
AGENT_MAX_OUTPUT_TOKENS=600
AGENT_MAX_TOOL_ROUNDS=2

# OCR + rule engine. GEMINI_API_KEY (above) is used for document OCR; without it uploads
# are stored but not read, and every case goes to a human. OCR_MODULE_DIR defaults to ./ocr.
GEMINI_OCR_MODEL=gemini-2.5-flash
# OCR_MODULE_DIR=../ocr
# OCR_NODE_BINARY=node

# LINE (optional). LINE_INTEGRATION_SECRET must match between the backend and the bot;
# the internal API is disabled while it is empty. FRONTEND_ORIGIN is used in link messages.
LINE_INTEGRATION_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
FRONTEND_ORIGIN=http://localhost:3000

# Local Postgres URL. Docker Compose overrides the host to `postgres`.
# For zero-service local development, use sqlite:///./ai_subsidy_demo.db.
DATABASE_URL=postgresql+psycopg://subsidy:subsidy@localhost:5432/ai_subsidy
DEMO_MODE=true
DEMO_AUTH_SECRET=local-demo-only-change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_RECEIPT_BYTES=5242880
MAX_PDF_PAGES=10
MAX_EXTRACTED_CHARS=50000
RECEIPT_STORAGE_DIR=storage/receipts
KNOWLEDGE_DIR=../knowledge
DEMO_RECEIPTS_DIR=../demo/receipts

# Read by the browser at frontend build/runtime.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
