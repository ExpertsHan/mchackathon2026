{
  "manifest_version": 3,
  "name": "全通用 AI 資安防護小幫手",
  "version": "1.1",
  "description": "自動監聽並攔截所有生成式 AI 工具中的個資外洩與 Prompt Injection 風險",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}